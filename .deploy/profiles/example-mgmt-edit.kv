# =============================================================================
# Пример массового файла для:
#   python3 .deploy/scripts/profile-mgmt.py edit .deploy/profiles/example-mgmt-edit.kv
# Справочник полей: .deploy/profiles/README.md («Менеджер профилей»)
#
# Правила:
#   - строка = «пакет изменений»: меняется ТОЛЬКО указанное, остальное не трогается;
#   - несколько строк с одним IMSI сливаются (аддитивно, позже записанное побеждает);
#   - apn= (или qos/arp/ambr_d/ambr_u/ipv4/ipv6) = upsert ОДНОЙ сессии в slice
#     (sst, sd): с тем же именем — обновить, новое имя — добавить;
#     остальные сессии/slice не трогается (лимиты: 4 сессии/slice, 8 slice);
#   - пустое значение = ОЧИСТИТЬ (только msisdn, imeisv, mme_host, mme_realm,
#     ipv4, ipv6);
#   - значение с запятыми — в кавычках: "arp=8,1,2";
#   - любая ошибка в любой строке прерывает весь файл ДО записи (fail-closed);
#   - --dry-run — только проверка, --backup — бэкап (содержит ключи!).
# =============================================================================
#
# --- Пример 1: два APN со статическими IP в дефолтном slice + третий APN в
#     отдельном slice (sst=1, sd=201111) ---
#imsi=000000000000001, apn=internet, qos=9, ambr_d=500M, ambr_u=500M, ipv4=10.167.71.200
#imsi=000000000000001, apn=voip, apn_type=dedicated, qos=5, "arp=5,1,1", ipv4=10.167.71.201
#imsi=000000000000001, apn=local, sst=1, sd=201111
#
# --- Пример 2: MSISDN + ограничение доступа (ho to non-3GPP not allowed) ---
#imsi=000000000000002, msisdn=799900000002, access_restriction=ho to non-3GPP not allowed
#
# --- Пример 3: блокировка абонента (barring) + RAU/TAU таймер 15 мин ---
#imsi=000000000000003, status=barring, barring=all ps barred, tau=15
#
# --- Пример 4: снять статический IP (пустое значение = очистить) ---
#imsi=000000000000001, apn=internet, ipv4=
#
# --- Пример 4b: переименовать APN (internet -> test4, параметры сохраняются) ---
#imsi=000000000000001, rename_apn=internet:test4
#
# --- Пример 4c: удалить APN (voip) из slice (sst, sd) ---
#imsi=000000000000001, del_apn=voip
#
# --- Пример 5: СОЗДАНИЕ абонента (create=yes) — обязательно с ключами;
#     для загрузки ключей предпочтителен EKI-TK-поток (import-profiles.sh) ---
#imsi=000000000000004, create=yes, security_k=<32-hex Ki>, security_opc=<32-hex OPc>
#imsi=000000000000004, apn=internet, ipv4=10.167.71.210
